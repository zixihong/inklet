{
  "name": "inklet",
  "version": "1.0.0",
  "description": "Turn any image into interactive, colored ASCII art for the web",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./react": {
      "import": "./dist/src/react/index.js",
      "types": "./dist/src/react/index.d.ts"
    }
  },
  "bin": {
    "inklet": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "src/editor/template.html"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "keywords": [
    "inklet",
    "ascii",
    "ascii-art",
    "image",
    "image-to-ascii",
    "interactive",
    "react",
    "cli",
    "color"
  ],
  "author": "Bryan Hong",
  "repository": {
    "type": "git",
    "url": "https://github.com/zixihong/inklet.git"
  },
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
